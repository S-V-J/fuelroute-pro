{
  "dashboard": {
    "title": "FuelRoute Pro - Production Metrics",
    "tags": ["fuelroute", "django", "production"],
    "timezone": "utc",
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/s)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(django_http_requests_total_by_method_view[5m])",
            "legendFormat": "{{method}} {{view}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Request Latency (p50/p95/p99)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(django_http_request_latency_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(django_http_request_latency_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(django_http_request_latency_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate by Status Code",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(django_http_responses_total_by_status_view[5m])",
            "legendFormat": "{{status}} {{view}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Cache Hit/Miss Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(django_cache_hit_total[5m])",
            "legendFormat": "hits"
          },
          {
            "expr": "rate(django_cache_miss_total[5m])",
            "legendFormat": "misses"
          }
        ]
      },
      {
        "id": 5,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "django_db_connections",
            "legendFormat": "{{database}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Active Users (Sessions)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "django_session_active",
            "legendFormat": "active sessions"
          }
        ]
      },
      {
        "id": 7,
        "title": "Route Plan Requests",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(django_http_requests_total_by_method_view{view=~\"PlanRouteView\"}[5m])",
            "legendFormat": "plan requests"
          }
        ]
      },
      {
        "id": 8,
        "title": "External API Latency",
        "type": "graph",
        "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(django_http_request_latency_seconds_sum{view=~\"PlanRouteView\"}[5m]) / rate(django_http_request_latency_seconds_count{view=~\"PlanRouteView\"}[5m])",
            "legendFormat": "avg latency (s)"
          }
        ]
      }
    ]
  },
  "overwrite": true
}